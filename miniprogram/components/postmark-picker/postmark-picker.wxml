<view class="picker">
  <view class="title">选择邮戳</view>
  <view wx:if="{{loading && postmarks.length === 0}}" class="loading">
    <view class="spinner"></view>
  </view>
  <scroll-view wx:else scroll-x class="scroll-row">
    <view
      wx:for="{{postmarks}}"
      wx:key="id"
      class="card {{selected === item.id ? 'selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSelect"
    >
      <image
        wx:if="{{item.display_url}}"
        class="pm-img"
        src="{{item.display_url}}"
        mode="aspectFill"
      />
      <text wx:else class="pm-icon">⭕</text>
      <text class="pm-label">{{item.label}}</text>
    </view>
  </scroll-view>
</view>
