.picker {
  padding: 0 16rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.remove-btn {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
}

.loading {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(124, 77, 255, 0.3);
  border-top-color: #7C4DFF;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.group-tabs {
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.group-tab {
  display: inline-block;
  padding: 8rpx 20rpx;
  margin-right: 10rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.06);
}

.group-tab-active {
  background: linear-gradient(135deg, #7C4DFF, #9B7BFF);
  border-color: transparent;
  box-shadow: 0 2rpx 8rpx rgba(124, 77, 255, 0.35);
}

.group-tab-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
}

.group-tab-active .group-tab-text {
  color: #fff;
  font-weight: 600;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.card {
  width: calc(25% - 9rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.card.selected {
  background: rgba(124, 77, 255, 0.12);
  border-color: #7C4DFF;
  border-width: 3rpx;
  box-shadow: 0 0 20rpx rgba(124, 77, 255, 0.25);
}

.pm-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
}

.pm-icon {
  font-size: 56rpx;
  line-height: 1.2;
}

.pm-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-top: 6rpx;
}

.card.selected .pm-label {
  color: #fff;
}
