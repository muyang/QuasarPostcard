.picker {
  padding: 0 16rpx;
}

.title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
  margin-bottom: 16rpx;
}

.loading {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(124, 77, 255, 0.3);
  border-top-color: #7C4DFF;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.card {
  width: calc(25% - 9rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  background: #1E1E36;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.card.selected {
  border-color: #7C4DFF;
  border-width: 4rpx;
  box-shadow: 0 0 16rpx rgba(124, 77, 255, 0.25);
}

.pm-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
}

.pm-icon {
  font-size: 56rpx;
  line-height: 1.2;
}

.pm-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.54);
  margin-top: 6rpx;
}

.card.selected .pm-label {
  color: #fff;
}
