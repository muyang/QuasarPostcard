.step-bar {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 16rpx 0;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 12rpx;
}

.step-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  border: 3rpx solid rgba(255, 255, 255, 0.12);
  transition: all 0.25s;
}

.step-circle.active {
  width: 72rpx;
  height: 72rpx;
  background: rgba(124, 77, 255, 0.25);
  border-color: rgba(155, 123, 255, 0.6);
  box-shadow: 0 0 12rpx rgba(124, 77, 255, 0.3);
}

.step-circle.done {
  background: rgba(124, 77, 255, 0.15);
  border-color: rgba(124, 77, 255, 0.35);
}

.step-icon {
  font-size: 28rpx;
}

.step-circle.active .step-icon {
  font-size: 34rpx;
}

.step-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 6rpx;
}

.step-label.label-active {
  color: #A78BFF;
  font-weight: 600;
}
