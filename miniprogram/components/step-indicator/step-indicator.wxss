.step-bar {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 16rpx 0;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 16rpx;
}

.step-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1E1E3A;
  border: 3rpx solid #2A2A4A;
  transition: all 0.25s;
}

.step-circle.active {
  width: 72rpx;
  height: 72rpx;
  background: #7C4DFF;
  border-color: #9B7BFF;
}

.step-circle.done {
  background: rgba(124, 77, 255, 0.25);
  border-color: rgba(124, 77, 255, 0.4);
}

.step-icon {
  font-size: 28rpx;
}

.step-circle.active .step-icon {
  font-size: 34rpx;
}

.step-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-top: 6rpx;
}

.step-label.label-active {
  color: #7C4DFF;
  font-weight: 600;
}
