.editor-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-dark);
}

.header {
  display: flex;
  align-items: center;
  padding: 0 0 0 24rpx;
  box-sizing: border-box;
}

.back-btn {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.save-btn {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}

.save-btn.disabled {
  opacity: 0.5;
}

/* Canvas area */
.canvas-wrap {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  min-height: 360rpx;
}

.canvas-inner {
  position: relative;
  border-radius: 16rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.3);
}

.canvas {
  border-radius: 16rpx;
  display: block;
}

/* Panel */
.panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--bg-panel);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  overflow: hidden;
  min-height: 0;
}

.divider {
  height: 2rpx;
  background: rgba(255, 255, 255, 0.08);
}

.step-content {
  flex: 1;
  padding: 16rpx 0;
  min-height: 0;
}

/* Step navigation */
.step-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  margin-top: 24rpx;
}

.spacer { flex: 1; }

.btn-primary {
  background: var(--primary);
  border-radius: 40rpx;
  padding: 16rpx 44rpx;
}

.btn-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-outline {
  border: 2rpx solid #333355;
  border-radius: 40rpx;
  padding: 16rpx 44rpx;
}

.btn-outline-text {
  color: rgba(255, 255, 255, 0.54);
  font-size: 28rpx;
}

/* Text step */
.text-step {
  padding: 0 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
  display: block;
  margin-bottom: 20rpx;
}

.msg-title {
  margin-top: 32rpx;
}

.input-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.input-label {
  width: 100rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.7);
}

.text-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
}

.msg-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* Send step */
.send-step {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
}

.send-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.send-loading-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.send-loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* Bottom toolbar */
.bottom-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-dark);
  border-top: 2rpx solid rgba(255, 255, 255, 0.08);
}

.toolbar-btn {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
}

.toolbar-back {
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  background: rgba(255, 255, 255, 0.06);
}

.toolbar-save {
  background: var(--primary);
}

.toolbar-save.disabled {
  opacity: 0.5;
}

.toolbar-btn-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* Text edit hint */
.text-hint-overlay {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(124, 77, 255, 0.9);
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
  z-index: 10;
  animation: fadeInOut 3s ease-in-out forwards;
}

.text-hint-text {
  font-size: 22rpx;
  color: #fff;
}

@keyframes fadeInOut {
  0% { opacity: 0; transform: translateY(-10rpx); }
  20% { opacity: 1; transform: translateY(0); }
  80% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-10rpx); }
}

/* Text edit modal */
.text-edit-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.text-edit-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.text-edit-panel {
  position: relative;
  background: var(--bg-panel);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.text-edit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.text-edit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.text-edit-close {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.5);
  padding: 8rpx;
}

.text-edit-body {
  margin-bottom: 24rpx;
}

.text-edit-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  color: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.text-edit-textarea {
  height: 160rpx;
  padding: 16rpx 24rpx;
}

.text-edit-styles {
  margin-top: 16rpx;
}

.text-edit-style-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 12rpx;
  display: block;
}

.text-edit-fonts {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.text-edit-font-item {
  flex: 1;
  padding: 16rpx 0;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  text-align: center;
}

.text-edit-font-item.active {
  background: rgba(124, 77, 255, 0.2);
  border-color: #7C4DFF;
}

.text-edit-font-text {
  font-size: 26rpx;
  color: #fff;
}

.text-edit-sizes {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.text-edit-size-item {
  flex: 1;
  padding: 16rpx 0;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  text-align: center;
}

.text-edit-size-item.active {
  background: rgba(124, 77, 255, 0.2);
  border-color: #7C4DFF;
}

.text-edit-size-text {
  color: #fff;
}

.text-edit-colors {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.text-edit-color-item {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.text-edit-color-item.active {
  border-color: #fff;
  box-shadow: 0 0 0 4rpx #7C4DFF;
}

.text-edit-actions {
  display: flex;
  gap: 24rpx;
}

.text-edit-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 40rpx;
  text-align: center;
}

.text-edit-cancel {
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.text-edit-confirm {
  background: var(--primary);
}

.text-edit-btn-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}
