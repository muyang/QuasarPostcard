.editor-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-dark);
}

.header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.back-btn {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.save-btn {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}

.save-btn.disabled {
  opacity: 0.5;
}

/* Canvas area */
.canvas-wrap {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  min-height: 360rpx;
}

.canvas {
  border-radius: 16rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.3);
}

/* Panel */
.panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #13132B;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  overflow: hidden;
  min-height: 0;
}

.divider {
  height: 2rpx;
  background: #1E1E3A;
}

.step-content {
  flex: 1;
  padding: 16rpx 0;
  min-height: 0;
}

/* Step navigation */
.step-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  margin-top: 24rpx;
}

.spacer { flex: 1; }

.btn-primary {
  background: var(--primary);
  border-radius: 40rpx;
  padding: 16rpx 44rpx;
}

.btn-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-outline {
  border: 2rpx solid #333355;
  border-radius: 40rpx;
  padding: 16rpx 44rpx;
}

.btn-outline-text {
  color: rgba(255, 255, 255, 0.54);
  font-size: 28rpx;
}

/* Send button */
.send-nav {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-send {
  background: var(--primary);
  border-radius: 44rpx;
  padding: 18rpx 40rpx;
}

.btn-send.disabled {
  background: #2A2A4A;
}

.btn-send-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-send.disabled .btn-send-text {
  color: rgba(255, 255, 255, 0.38);
}

/* Text step */
.text-step {
  padding: 0 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
  display: block;
  margin-bottom: 20rpx;
}

.msg-title {
  margin-top: 32rpx;
}

.input-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.input-label {
  width: 100rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.7);
}

.text-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
}

.msg-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
}
