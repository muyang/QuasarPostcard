.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: var(--bg-dark);
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.nav-actions {
  display: flex;
  gap: 24rpx;
}

.nav-btn {
  font-size: 26rpx;
  color: var(--primary);
}

.login-btn {
  background: var(--primary);
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.login-banner {
  display: flex;
  align-items: center;
  margin: 0 24rpx 8rpx;
  padding: 16rpx 20rpx;
  background: rgba(124, 77, 255, 0.12);
  border: 2rpx solid rgba(124, 77, 255, 0.25);
  border-radius: 16rpx;
}

.login-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.login-hint {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.login-arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.3);
}

.center-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid rgba(124, 77, 255, 0.3);
  border-top-color: #7C4DFF;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.hint-text {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
}

.error-text {
  color: #ff5252;
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 24rpx;
  padding: 12rpx 40rpx;
  border: 2rpx solid var(--primary);
  border-radius: 40rpx;
}

.retry-text {
  color: var(--primary);
  font-size: 26rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.6);
}

.empty-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.grid-item {
  width: calc(50% - 8rpx);
}

.delete-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(13, 13, 26, 0.95);
  backdrop-filter: blur(10px);
}

.delete-btn {
  background: #ff5252;
  border-radius: 44rpx;
  padding: 20rpx 0;
  text-align: center;
}

.delete-btn.disabled {
  opacity: 0.6;
}

.delete-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(124, 77, 255, 0.4);
}

.fab-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}
