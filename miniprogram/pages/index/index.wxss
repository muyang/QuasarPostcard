.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 0 32rpx;
  background: var(--bg-dark);
  box-sizing: border-box;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.nav-actions {
  display: flex;
  gap: 24rpx;
}

.nav-btn {
  font-size: 26rpx;
  color: var(--primary);
}

/* Not logged in: centered login */
.login-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: calc(100vh - 200rpx);
  padding: 0 48rpx;
}

.login-icons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.login-emoji {
  font-size: 64rpx;
}

.login-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.wx-login-btn {
  width: 100%;
  max-width: 600rpx;
  padding: 28rpx 0;
  background: #07C160;
  border-radius: 48rpx;
  text-align: center;
}

.wx-login-btn.disabled {
  opacity: 0.6;
}

.wx-login-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}

.login-hint {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
}

/* Loading / empty / error */
.center-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid rgba(124, 77, 255, 0.3);
  border-top-color: #7C4DFF;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.hint-text {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
}

.error-text {
  color: #ff5252;
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 24rpx;
  padding: 12rpx 40rpx;
  border: 2rpx solid var(--primary);
  border-radius: 40rpx;
}

.retry-text {
  color: var(--primary);
  font-size: 26rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.6);
}

.empty-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* 2-column grid (logged in) */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.grid-item {
  width: calc(50% - 8rpx);
}

/* Delete bar */
.delete-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(13, 13, 26, 0.95);
  backdrop-filter: blur(10px);
  z-index: 100;
}

.delete-btn {
  background: #ff5252;
  border-radius: 44rpx;
  padding: 20rpx 0;
  text-align: center;
}

.delete-btn.disabled {
  opacity: 0.6;
}

.delete-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* Bottom-left login/logout button */
.bottom-left-btn {
  position: fixed;
  left: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  padding: 14rpx 36rpx;
  border: 2rpx solid #333355;
  border-radius: 40rpx;
  background: rgba(19, 19, 43, 0.9);
  z-index: 50;
}

.bottom-btn-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(124, 77, 255, 0.4);
  z-index: 50;
}

.fab-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}
