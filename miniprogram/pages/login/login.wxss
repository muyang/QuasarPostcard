.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: var(--bg-dark);
  padding: 0 48rpx;
  box-sizing: border-box;
}

.loading-box {
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid rgba(124, 77, 255, 0.3);
  border-top-color: #7C4DFF;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Brand */
.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.brand-logo {
  width: 256rpx;
  height: 256rpx;
  margin-bottom: 16rpx;
}

.brand-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #D4A5A5;
  letter-spacing: 2rpx;
}

.brand-slogan {
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.login-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.wx-login-btn {
  width: 100%;
  max-width: 600rpx;
  padding: 28rpx 0;
  background: #07C160;
  border-radius: 48rpx;
  text-align: center;
}

.wx-login-btn.disabled {
  opacity: 0.6;
}

.wx-login-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}

.login-hint {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
}
