<view class="login-page" style="padding-top: {{statusBarHeight}}px;">
  <view wx:if="{{!ready}}" class="loading-box">
    <view class="spinner"></view>
  </view>

  <block wx:else>
    <view class="brand">
      <text class="brand-icon">&#x1F48C;</text>
      <text class="brand-title">明信片设计器</text>
      <text class="brand-desc">设计专属明信片，传递温暖祝福</text>
    </view>

    <view class="actions">
      <view class="wx-login-btn {{logging ? 'disabled' : ''}}" bindtap="onLogin">
        <text class="wx-login-text">{{logging ? '登录中...' : '微信登录'}}</text>
      </view>
      <text class="skip-text" bindtap="onSkip">先逛逛</text>
    </view>
  </block>
</view>
